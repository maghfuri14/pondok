# Backend Fase 3 — Sistem Informasi Pondok Al Hidayah
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=al_hidayah
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=changes-me-in-production
SESSION_TTL_HOURS=12

# Frontend (Vite): 'api' = produksi memakai backend; 'local' = prototype localStorage
VITE_API_MODE=api
VITE_API_URL=http://localhost:3001

# Catatan: mode default = API/DB. Untuk E2E demo lokal, lihat env.test.example.
# Production: salin env.production.example → .env.production lalu set VITE_API_URL.
